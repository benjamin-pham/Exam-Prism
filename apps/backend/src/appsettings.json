{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogConnection": "Host=localhost;Port=5432;Database=examprism_catalog_dev;Username=postgres;Password=postgres",
    "Redis": ""
  },
  "MultiTenancy": {
    "BaseDomains": [ "examprism.com", "localhost" ],
    "ReservedSubdomains": [ "www", "admin", "api" ],
    "AllowHeaderFallbackInDevelopment": true,
    "HeaderName": "X-Tenant",
    "CatalogCacheExpirationMinutes": 30,
    "CatalogLocalCacheExpirationMinutes": 5,
    "NotFoundCacheExpirationSeconds": 30,
    "ProvisioningRetryAfterSeconds": 5,
    "DatabasePool": {
      "MaxPoolSize": 15,
      "MinPoolSize": 0,
      "ConnectionIdleLifetimeSeconds": 30,
      "ConnectionPruningIntervalSeconds": 10
    },
    "Provisioning": {
      "ServerConnectionString": "",
      "DatabaseNamePrefix": "examprism_tenant_",
      "DedicatedUserPrefix": "examprism_u_",
      "CreateDedicatedPostgresUser": false,
      "RecoverStuckProvisioningOnStartup": true
    },
    "FleetMigration": {
      "MigrateOnStartup": false,
      "MaxDegreeOfParallelism": 10
    }
  },
  "Caching": {
    "KeyPrefix": "examprism:",
    "DefaultExpirationMinutes": 30,
    "DefaultLocalExpirationMinutes": 5
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "ExamPrism",
    "Audience": "ExamPrism",
    "SecretKey": "SuperSecretKeyForDevJwtTokensMin256BitsLongExamPrismDevOnly!",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "PlatformAdmin": {
    "SeedOnStartup": false,
    "Email": "",
    "Password": ""
  }
}
