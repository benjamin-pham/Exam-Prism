{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogConnection": "Host=localhost;Port=5432;Database=examprism_catalog_dev;Username=postgres;Password=postgres",
    "Redis": ""
  },
  "Persistence": {
    "CommandTimeoutSeconds": 30,
    "MaxBatchSize": 100,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "SlowQueryThresholdMs": 500,
    "CatalogReadConnection": "",
    "TenantReadReplicaHost": ""
  },
  "MultiTenancy": {
    "BaseDomains": [ "examprism.com", "localhost" ],
    "ReservedSubdomains": [ "www", "admin", "api" ],
    "AllowHeaderFallbackInDevelopment": true,
    "HeaderName": "X-Tenant",
    "CatalogCacheExpirationMinutes": 30,
    "CatalogLocalCacheExpirationMinutes": 5,
    "NotFoundCacheExpirationSeconds": 30,
    "MaxNegativeCacheEntries": 2000,
    "MaxCatalogDbMissesPerSecond": 50,
    "ProvisioningRetryAfterSeconds": 5,
    "DatabasePool": {
      "MaxPoolSize": 15,
      "MinPoolSize": 0,
      "ConnectionIdleLifetimeSeconds": 30,
      "ConnectionPruningIntervalSeconds": 10,
      "NoResetOnClose": true,
      "KeepAliveSeconds": 30
    },
    "Provisioning": {
      "ServerConnectionString": "",
      "DatabaseNamePrefix": "examprism_tenant_",
      "DedicatedUserPrefix": "examprism_u_",
      "CreateDedicatedPostgresUser": false,
      "RecoverStuckProvisioningOnStartup": true
    },
    "FleetMigration": {
      "MigrateOnStartup": false,
      "MaxDegreeOfParallelism": 10
    }
  },
  "Caching": {
    "KeyPrefix": "examprism:",
    "DefaultExpirationMinutes": 30,
    "DefaultLocalExpirationMinutes": 5,
    "EnableBackplane": true,
    "BackplaneChannelName": "cache:backplane",
    "OutputCacheExpirationSeconds": 30
  },
  "Locking": {
    "KeyPrefix": "lock:",
    "DefaultExpirySeconds": 30
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "TenantOnboarding": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  },
  "Jwt": {
    "Issuer": "ExamPrism",
    "Audience": "ExamPrism",
    "SecretKey": "SuperSecretKeyForDevJwtTokensMin256BitsLongExamPrismDevOnly!",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "PlatformAdmin": {
    "SeedOnStartup": false,
    "Email": "",
    "Password": ""
  },
  "Orleans": {
    "ClusterId": "examprism-cluster",
    "ServiceId": "examprism-service",
    "StateStoreName": "Default",
    "SiloPort": 11111,
    "GatewayPort": 30000,
    "AdvertisedIpAddress": "",
    "LoadSheddingEnabled": true,
    "LoadSheddingLimitPercent": 95,
    "CollectionAgeMinutes": 15,
    "CollectionQuantumMinutes": 1,
    "ResponseTimeoutSeconds": 15
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "BackoffBaseDelaySeconds": 0.5,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDurationSeconds": 30,
    "CircuitBreakerBreakDurationSeconds": 15,
    "CircuitBreakerMinimumThroughput": 20,
    "TimeoutSeconds": 10
  },
  "LoadShedding": {
    "Enabled": true,
    "InitialConcurrencyLimit": 100,
    "MinConcurrencyLimit": 20,
    "MaxConcurrencyLimit": 500,
    "RetryAfterSeconds": 2
  },
  "Batching": {
    "Capacity": 10000,
    "MaxBatchSize": 100,
    "FlushIntervalMs": 100
  },
  "IdentityHighLoad": {
    "MaxConcurrentPasswordHashes": 8,
    "PasswordHashQueueTimeoutMs": 2000,
    "EnableTokenRevocationCheck": true,
    "TokenRevocationCacheTtlMinutes": 1440
  },
  "DdosProtection": {
    "Enabled": true,
    "BanThresholdScore": 100,
    "StrikeWindowSeconds": 300,
    "BanDurationSeconds": 900,
    "UnknownTenantProbeWeight": 25,
    "RateLimitExceededWeight": 15,
    "MalformedPayloadWeight": 20,
    "DecompressionBombWeight": 50,
    "BypassPenaltyBoxForValidJwt": true,
    "MaxDecompressedBodySizeBytes": 10485760,
    "MaxDecompressionRatio": 20
  },
  "RuntimeTuning": {
    "MinRequestBodyDataRateBytesPerSecond": 240,
    "MinResponseDataRateBytesPerSecond": 240,
    "DataRateGracePeriodSeconds": 5,
    "MaxRequestHeaderCount": 100,
    "MaxRequestHeadersTotalSizeBytes": 32768,
    "MaxRequestLineSizeBytes": 8192
  },
  "Telemetry": {
    "OtlpEndpoint": "",
    "EnablePrometheusEndpoint": true,
    "TraceSamplingRatio": 1.0,
    "AlwaysSampleSlowRequestsMs": 500
  }
}
